# Copy this file to ".env" and fill in your values.

# --- Twilio (for actually sending texts) ---
# Sign up at https://www.twilio.com — these are on your Twilio Console dashboard.
# Leave these blank to run in TEST MODE (messages are logged but not sent).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# The Twilio phone number you bought, in +1XXXXXXXXXX format:
TWILIO_FROM_NUMBER=

# --- Google review link ---
# From your Google Business Profile: google.com/business -> "Ask for reviews".
# It looks like https://g.page/r/XXXXXXXX/review
# (You can also set/change this in the app's Settings panel instead.)
GOOGLE_REVIEW_LINK=

# --- Optional: protect the app with a password ---
# If set, the browser will ask for this password before showing the page.
# Recommended if you host this on the internet.
APP_PASSWORD=

# Port the app runs on (default 3000)
PORT=3000
