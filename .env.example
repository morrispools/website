# Copy this file to ".env" and fill in your values.

# --- Twilio (for actually sending texts) ---
# Sign up at https://www.twilio.com — these are on your Twilio Console dashboard.
# Leave these blank to run in TEST MODE (messages are logged but not sent).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# The Twilio phone number you bought, in +1XXXXXXXXXX format:
TWILIO_FROM_NUMBER=

# --- Google review link ---
# From your Google Business Profile: google.com/business -> "Ask for reviews".
# It looks like https://g.page/r/XXXXXXXX/review
# (You can also set/change this in the app's Settings panel instead.)
GOOGLE_REVIEW_LINK=

# --- Poolbrain integration (texts fire when a job is closed out) ---
# In Poolbrain: Settings -> API -> Webhooks. Add a webhook pointing to
#   https://YOUR-APP-URL/webhooks/poolbrain
# and paste the Signing Secret Poolbrain shows you here:
POOLBRAIN_SIGNING_SECRET=
# Which Poolbrain events trigger a review text (comma separated, * wildcard OK).
# Default covers one-time jobs (repairs/installs) so weekly service visits
# don't trigger texts:
POOLBRAIN_EVENTS=job.one_time.*

# --- JobTread integration (texts fire when a daily log is created) ---
# Make up a long random password and put it here, then in JobTread create a
# webhook (Settings -> Webhooks) for Daily Log events pointing to:
#   https://YOUR-APP-URL/webhooks/jobtread?key=THAT-SAME-PASSWORD
JOBTREAD_WEBHOOK_KEY=
# Optional but recommended: a JobTread API grant key (Settings -> API) so the
# app can look up the client's phone number when it isn't in the webhook:
JOBTREAD_GRANT_KEY=

# --- NiceJob hand-off (optional alternative to Twilio) ---
# If you use NiceJob, the app can push clients into your NiceJob review
# campaign instead of texting them itself. NiceJob's direct API is
# partner-only, so this goes through a Zapier "Catch Hook":
#   Zapier trigger: Webhooks by Zapier -> Catch Hook (paste its URL below)
#   Zapier action:  NiceJob -> Create/Update Person & Enroll in Campaign
# Then pick "Hand off to NiceJob" in the app's Settings.
NICEJOB_FORWARD_URL=

# --- Website AI assistant (chat widget for morrispools.com) ---
# Get an API key at https://console.anthropic.com (Settings -> API keys).
# Leave blank to keep the chat widget off.
ANTHROPIC_API_KEY=
# Text this number whenever the chat captures a lead (needs Twilio set up).
# E.g. Daniel's cell: +15551234567
LEAD_NOTIFY_PHONE=
# Safety cap on chat messages per day (cost guard). Default 300.
ASSISTANT_DAILY_LIMIT=300

# --- Optional: protect the app with a password ---
# If set, the browser will ask for this password before showing the page.
# Recommended if you host this on the internet.
APP_PASSWORD=

# Port the app runs on (default 3000)
PORT=3000
